{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CameraMaintainer": "Information",
      "System.Net.Http.HttpClient.CameraGeocoding": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Geocoding": {
    "ReverseUrl": "https://nominatim.openstreetmap.org/reverse"
  },
  "Accounts": {
    "AllowSelfRegistration": false
  },
  "Health": {
    "CycleIntervalSeconds": 60
  },
  "Snapshots": {
    "CacheMegabytes": 128,
    "ConcurrentDownloads": 4,
    "ArchivePath": ""
  },
  "Backup": {
    "Concurrency": 4
  },
  "Discovery": {
    "IntervalMinutes": 5
  },
  "Onvif": {
    "CapabilityCacheTtlMinutes": 30
  },
  "Firmware": {
    "Baselines": {
      "Hikvision|DS-2CD2T47G2-L": "5.7.15",
      "Hikvision|DS-2CD2147G2-SU": "5.7.15",
      "Dahua|IPC-HDW5442TM-AS": "2.840.0000000.0.R",
      "Axis|P3245-LVE": "10.12.1"
    }
  },
  "Urls": "http://0.0.0.0:5100"
}
